#!/usr/bin/make -f

DEST := debian/dupeguru
APPDIR := $(DEST)/usr/lib/dupeguru

%:
	dh $@

override_dh_auto_build:
	python3 build_pe_modules.py

override_dh_auto_test:

override_dh_auto_install:
	mkdir -p $(APPDIR) $(DEST)/usr/bin $(DEST)/usr/share/applications $(DEST)/usr/share/icons/hicolor/128x128/apps
	cp -R src/. $(APPDIR)/
	find $(APPDIR) -depth \( -name tests -o -name __pycache__ \) -type d -exec rm -rf {} +
	chmod 755 $(APPDIR)/run.py
	# Ship the bytecode so nothing is written into /usr/lib/dupeguru at runtime and removal leaves no files
	python3 -m compileall -q -d /usr/lib/dupeguru $(APPDIR)
	printf '#!/bin/sh\nexec /usr/bin/python3 /usr/lib/dupeguru/run.py "$$@"\n' > $(DEST)/usr/bin/dupeguru
	chmod 755 $(DEST)/usr/bin/dupeguru
	install -m 644 debian/dupeguru.desktop $(DEST)/usr/share/applications/dupeguru.desktop
	install -m 644 src/images/dgse_logo_128.png $(DEST)/usr/share/icons/hicolor/128x128/apps/dupeguru.png
